{
  "name": "heybox-dark-souls-2-map",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "heybox": {
    "miniProgramId": "01a185dc-bf4e-757c-8926-d031e3a1ebff",
    "name": "多兰古雷格地图志",
    "desc": "黑暗之魂2（Dark Souls II）全境27张地图（含失落王冠三大DLC与原版全景天空贴图）白模三维查看器，消除安第尔之馆与虚影森林大面积穿模（安第尔与巨龙圣域独立连通域载入），大陆19张大地图连通全量大世界同屏载入，传送独立异空间自洽独立加载，左下角轻量加载进度圆圈HUD，设置界面卡片精简纯中文与DLC专属标识，第一人称漫步、自由飞行、小黑盒原生全屏横屏与素模线框双渲染。",
    "category": "tool",
    "icon": "assets/icon.png",
    "coverImages": [
      "assets/cover.jpg"
    ],
    "platforms": [
      "android",
      "ios",
      "ohos",
      "windows",
      "macos"
    ],
    "permissions": {
      "leaderboard": {
        "enabled": true
      },
      "userInfo": {
        "enabled": true
      },
      "storage": {
        "enabled": true
      }
    },
    "window": {
      "defaultWidth": 1280,
      "defaultHeight": 720,
      "minWidth": 800,
      "minHeight": 450,
      "resizable": true
    }
  },
  "scripts": {
    "hb-sdk": "hb-sdk",
    "dev": "hb-sdk dev",
    "dev:vite": "vite --port 5190",
    "build": "npm run typecheck && hb-sdk build && node scripts/check-size.mjs",
    "build:vite": "npm run typecheck && vite build && node scripts/check-size.mjs",
    "typecheck": "tsc --noEmit",
    "prepare-maps": "node scripts/prepare-maps.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@heybox/hb-sdk": "^0.9.0",
    "fflate": "^0.8.3",
    "gl-matrix": "^3.4.3",
    "lucide": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
