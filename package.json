{
  "name": "heybox-dark-souls-2-map",
  "version": "0.3.35",
  "private": true,
  "type": "module",
  "heybox": {
    "miniProgramId": "01a185dc-bf4e-757c-8926-d031e3a1ebff",
    "name": "多兰古雷格地图志",
    "desc": "黑暗之魂2全境27张地图（含三大DLC与天空贴图）三维白模，全量收录949处黑魂原版木质/铁质宝箱3D模型与1200件正版道具，内置全流程全要素可视化路线互动图与NPC支线追踪，道具雷达跨地图检索瞬移，大陆全量连通同屏，漫步飞行与原生横屏全屏。",
    "category": "tool",
    "icon": "assets/icon.png",
    "coverImages": [
      "assets/cover.jpg"
    ],
    "platforms": [
      "android",
      "ios",
      "ohos",
      "windows",
      "macos"
    ],
    "permissions": {
      "leaderboard": {
        "enabled": true
      },
      "userInfo": {
        "enabled": true
      },
      "storage": {
        "enabled": true
      }
    },
    "window": {
      "defaultWidth": 1280,
      "defaultHeight": 720,
      "minWidth": 800,
      "minHeight": 450,
      "resizable": true
    }
  },
  "scripts": {
    "hb-sdk": "hb-sdk",
    "dev": "hb-sdk dev",
    "dev:vite": "vite --port 5190",
    "build": "npm run typecheck && hb-sdk build && node scripts/check-size.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:vite": "npm run typecheck && vite build && node scripts/check-size.mjs",
    "typecheck": "tsc --noEmit",
    "prepare-maps": "node scripts/prepare-maps.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@heybox/hb-sdk": "^0.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.3",
    "gl-matrix": "^3.4.3",
    "lucide": "^1.55.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
